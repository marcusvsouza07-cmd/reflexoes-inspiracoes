---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');

posts.sort(
  (a, b) =>
    b.data.date.getTime() -
    a.data.date.getTime()
);

const latestPosts = posts.slice(0, 3);
---

<BaseLayout
  title="Início"
  description="Reflexões e inspirações para o dia a dia"
>

  <section class="bg-gradient-to-b from-indigo-50 to-white py-24">

    <div class="max-w-5xl mx-auto px-4 text-center">

      <span
        class="inline-block px-4 py-2 rounded-full bg-indigo-100 text-indigo-700 text-sm font-medium mb-6"
      >
        Reflexões • Motivação • Inspiração
      </span>

      <h1 class="text-6xl font-bold mb-6">
        Reflexões & Inspirações
      </h1>

      <p class="text-xl text-gray-600 mb-10">
        Mensagens para fortalecer a mente,
        renovar a esperança e inspirar a caminhada diária.
      </p>

      <a
        href="/blog"
        class="inline-block bg-indigo-600 text-white px-8 py-4 rounded-xl hover:bg-indigo-700"
      >
        Ler Artigos
      </a>

    </div>

  </section>

  <section class="max-w-5xl mx-auto px-4 py-20">

    <h2 class="text-4xl font-bold mb-10">
      Últimas Publicações
    </h2>

    <div class="grid md:grid-cols-3 gap-6">

      {
        latestPosts.map((post) => (
          <article
            class="border rounded-xl p-6 hover:shadow-xl transition-all"
          >

            <span
              class="inline-block mb-3 px-3 py-1 bg-indigo-100 text-indigo-700 rounded-full text-sm"
            >
              {post.data.category}
            </span>

            <h3 class="text-xl font-semibold mb-3">
              <a href={`/blog/${post.id}`}>
                {post.data.title}
              </a>
            </h3>

            <p class="text-gray-600 mb-4">
              {post.data.description}
            </p>

            <p class="text-sm text-gray-500">
              {post.data.date.toLocaleDateString('pt-BR')}
            </p>

          </article>
        ))
      }

    </div>

  </section>

</BaseLayout>