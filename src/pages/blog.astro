---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');

posts.sort(
  (a, b) =>
    b.data.date.getTime() -
    a.data.date.getTime()
);
---

<BaseLayout title="Blog">

  <section class="max-w-6xl mx-auto px-4 py-16">

    <h1 class="text-5xl font-bold mb-4">
      Blog
    </h1>

    <p class="text-gray-600 dark:text-gray-400 mb-12">
      Reflexões, mensagens e inspirações para o dia a dia.
    </p>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">

      {
        posts.map((post) => (
          <article
            class="border rounded-2xl p-6 hover:shadow-xl transition-all bg-white dark:bg-gray-900"
          >
            <span
              class="inline-block mb-4 px-3 py-1 bg-indigo-100 text-indigo-700 rounded-full text-sm"
            >
              {post.data.category}
            </span>

            <h2 class="text-2xl font-bold mb-3">
              <a
                href={`/blog/${post.id}`}
                class="hover:text-indigo-600"
              >
                {post.data.title}
              </a>
            </h2>

            <p class="text-gray-600 dark:text-gray-400 mb-4">
              {post.data.description}
            </p>

            <p class="text-sm text-gray-500">
              {post.data.date.toLocaleDateString('pt-BR')}
            </p>
          </article>
        ))
      }

    </div>

  </section>

</BaseLayout>