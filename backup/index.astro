---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');

posts.sort(
  (a, b) =>
    b.data.date.getTime() -
    a.data.date.getTime()
);

const latestPosts = posts.slice(0, 3);
---

<BaseLayout
  title="Início"
  description="Reflexões e inspirações para o dia a dia"
>

  <section class="max-w-5xl mx-auto px-4 py-20 text-center">

    <h1 class="text-5xl font-bold mb-6">
      Reflexões & Inspirações
    </h1>

    <p class="text-xl text-gray-600 dark:text-gray-400 mb-12">
      Pequenas mensagens capazes de transformar grandes dias.
    </p>

    <a
      href="/blog"
      class="inline-block bg-indigo-600 text-white px-6 py-3 rounded-lg hover:bg-indigo-700"
    >
      Ver todos os artigos
    </a>

  </section>

  <section class="max-w-5xl mx-auto px-4 pb-20">

    <h2 class="text-3xl font-bold mb-8">
      Últimas Publicações
    </h2>

    <div class="space-y-6">

      {
        latestPosts.map((post) => (
          <article
            class="border rounded-xl p-6 hover:shadow-lg transition-shadow"
          >

            <span
              class="inline-block mb-3 px-3 py-1 bg-indigo-100 text-indigo-700 rounded-full text-sm"
            >
              {post.data.category}
            </span>

            <h3 class="text-2xl font-semibold mb-2">
              <a
                href={`/blog/${post.id}`}
                class="hover:text-indigo-600"
              >
                {post.data.title}
              </a>
            </h3>

            <p class="text-gray-600 dark:text-gray-400 mb-4">
              {post.data.description}
            </p>

            <p class="text-sm text-gray-500">
              {post.data.date.toLocaleDateString('pt-BR')}
            </p>

          </article>
        ))
      }

    </div>

  </section>

</BaseLayout>